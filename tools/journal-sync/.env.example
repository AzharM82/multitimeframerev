# journal-sync configuration — copy to journal-sync.env and fill in.
#
# journal-sync.env is gitignored and must STAY that way: it holds the standalone
# journal app's password and the portal's timer secret. Keeping both here, on
# this machine, is the entire point of the design — neither belongs in Azure.

# The standalone SnapTrade journal app (read-only source of Robinhood fills).
# Nothing about that app is modified; we call endpoints it already exposes.
JOURNAL_APP_URL=https://purple-forest-0e07c220f.7.azurestaticapps.net
JOURNAL_APP_PASSWORD=

# Strongly recommended. Lets this job do its own live SnapTrade pull for the
# recent window (persist=false — still a read, that app writes nothing).
#
# Without it you get only what that app has already stored, and it stores very
# little: its own sync tries to pull 90 days across every account and then
# re-run FIFO over the whole dataset, which exceeds Azure SWA's ~45s backend
# limit and dies as a bare "Backend call failure". That is why fills arrived
# here with no realized P&L at all. Scoped to a short window it answers in ~3s.
JOURNAL_APP_SCAN_SECRET=

# The MTF portal (destination).
PORTAL_URL=https://salmon-river-0a7a0c30f.1.azurestaticapps.net
# az staticwebapp appsettings list -n mtfrev-app -g rg-mtfrev --query "properties.TIMER_SECRET" -o tsv
PORTAL_TIMER_SECRET=
