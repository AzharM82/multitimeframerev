# Copy to .env next to publish_avwap.mjs and fill in. NEVER commit .env.
API_BASE=https://salmon-river-0a7a0c30f.1.azurestaticapps.net

# Same value as the SWA's TIMER_SECRET application setting:
#   az staticwebapp appsettings list --name mtfrev-app -g rg-mtfrev --query properties.TIMER_SECRET -o tsv
# (Plain --query paths only; JMESPath functions break through az.cmd on Windows.)
TIMER_SECRET=

TV_CDP_PORT=9222
TV_WATCHLIST=MASTER

# OPTIONAL but recommended on DESKTOP2: pin the sweep to ONE chart tab so it can
# never commandeer a chart another tool is reading. Use the chart id fragment
# from the URL, e.g. yaYerb4T for tradingview.com/chart/yaYerb4T/.
TV_CHART_URL=

TV_EXPECT_RESOLUTION=39
TV_SYMBOL_TIMEOUT_MS=12000
